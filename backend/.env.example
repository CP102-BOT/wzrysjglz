# 管理后台配置
# 复制此文件为 .env 并修改以下配置

# 管理员账号
ADMIN_USER=admin

# 管理员密码（首次部署必须修改！）
ADMIN_PASS=your_strong_password_here

# JWT 密钥（必须设置，重启后 token 仍然有效）
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=your_secret_key_here

# 数据库路径
DATABASE_URL=sqlite+aiosqlite:///data/data.db

# 允许的前端域名（CORS），多个用逗号分隔
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 文件上传大小限制（MB）
MAX_UPLOAD_SIZE=5
